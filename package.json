{
  "name": "chilis-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Chili's Design System (Perú) — Storybook generado desde Figma: Prueba - Chilis DS",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit",
    "design:check": "node scripts/check-design-md.mjs",
    "design:lint": "npx --yes @google/design.md lint DESIGN.md",
    "prebuild-storybook": "npm run design:check"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-themes": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "storybook": "10.6.1",
    "typescript": "^5.6.0",
    "vite": "8.3.2",
    "yaml": "^2.9.1"
  }
}
